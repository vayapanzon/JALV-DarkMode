<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Midnight theme for JALV. All background/text colors contrast against a dark surface. -->
    <LinearGradientBrush x:Key="DefaultGradientBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141920" Offset="0" />
        <GradientStop Color="#1B222D" Offset="0.35" />
        <GradientStop Color="#12171E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GrayGradientBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#303B4A" Offset="0" />
        <GradientStop Color="#25303D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DarkGradientBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#91CEFA" Offset="0" />
        <GradientStop Color="#76A8EF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DefaultForegroundColor" Color="#E6EDF5" />
    <SolidColorBrush x:Key="BorderColor" Color="#48566A" />
    <SolidColorBrush x:Key="ThemeGridBackground" Color="#171E27" />
    <SolidColorBrush x:Key="ThemeGridLines" Color="#3C4656" />
    <SolidColorBrush x:Key="ThemeHorizontalGridLines" Color="#303C49" />
    <SolidColorBrush x:Key="ThemeSplitterBackground" Color="#364353" />
    <SolidColorBrush x:Key="ThemeSortArrowBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="ThemeInputBackground" Color="#232D39" />
    <SolidColorBrush x:Key="ThemePromptForeground" Color="#A9B8C9" />
    <SolidColorBrush x:Key="ThemeFocusBorder" Color="#63C5E8" />
    <SolidColorBrush x:Key="ThemeDisabledForeground" Color="#7C8997" />
    <SolidColorBrush x:Key="ThemeSecondaryForeground" Color="#AEBDCF" />
    <SolidColorBrush x:Key="ThemeLinkForeground" Color="#82D7EF" />
    <SolidColorBrush x:Key="ThemeToolbarButtonBackground" Color="#273340" />
    <SolidColorBrush x:Key="ThemeToolbarButtonForeground" Color="#E6EDF5" />
    <SolidColorBrush x:Key="ThemeToolbarButtonBorder" Color="#48566A" />
    <SolidColorBrush x:Key="ThemeScrollTrack" Color="#1C2631" />
    <Color x:Key="ThemeGridSelectionColor">#885276A7</Color>
    <Color x:Key="ThemeFileHighlightColor">#345C7E</Color>

    <!-- Dark severity stripes: softer than a light theme, with legible light text. -->
    <SolidColorBrush x:Key="DebugLevelColor" Color="#263A53" />
    <SolidColorBrush x:Key="InfoLevelColor" Color="#254537" />
    <SolidColorBrush x:Key="WarnLevelColor" Color="#514123" />
    <SolidColorBrush x:Key="ErrorLevelColor" Color="#582D35" />
    <SolidColorBrush x:Key="FatalLevelColor" Color="#6C3049" />

    <!-- Scrollbars (existing templates use DynamicResource lookups). -->
    <SolidColorBrush x:Key="StandardBorderBrush" Color="#425266" />
    <SolidColorBrush x:Key="StandardBackgroundBrush" Color="#1E2732" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#6787A6" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#3C6287" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#728093" />
    <SolidColorBrush x:Key="NormalBrush" Color="#546A83" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="#354353" />
    <SolidColorBrush x:Key="HorizontalNormalBrush" Color="#546A83" />
    <SolidColorBrush x:Key="HorizontalNormalBorderBrush" Color="#354353" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#EDF4FE" />
    <SolidColorBrush x:Key="ListBoxBackgroundBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="StandardBrush" Color="#253242" />
    <SolidColorBrush x:Key="PressedBrush" Color="#344E6B" />

    <!-- System palette keys are used by the standard .NET 4 WPF templates,
         including ComboBox drop-downs and native menu popup elements. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A2330" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6EDF5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#253242" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6EDF5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#202B38" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6EDF5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#365A80" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#92A0B2" />

    <!-- Menu popup surfaces, input controls and lists use the native control templates
         with dark-aware colors, focus and selection states. -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="#1D2733" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#48566A" />
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="#202B38" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#48566A" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#34506D" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8795A7" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="#202B38" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#48566A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#232D39" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="CaretBrush" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#48566A" />
        <Setter Property="SelectionBrush" Value="#4F7FA9" />
        <Setter Property="Padding" Value="3,1" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#63C5E8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8491A2" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#2A394B" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#566B83" />
        <Setter Property="Padding" Value="4,2" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3A526D" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#466B91" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8290A0" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="#29394A" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#566B83" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#385C80" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="#253242" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#566B83" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#63C5E8" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="#253242" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#35587D" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#426A95" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="#1A2330" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#48566A" />
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#365A80" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A3E54" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#48566A" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style TargetType="{x:Type CheckBox}"><Setter Property="Foreground" Value="#E6EDF5" /></Style>
    <Style TargetType="{x:Type RadioButton}"><Setter Property="Foreground" Value="#E6EDF5" /></Style>
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="Background" Value="#2A394B" />
        <Setter Property="BorderBrush" Value="#566B83" />
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E6EDF5" />
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#2E3B49" />
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="BorderBrush" Value="#4B5B70" />
    </Style>
    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Foreground" Value="#E6EDF5" />
        <Setter Property="Background" Value="#171E27" />
    </Style>
    <Style TargetType="{x:Type Separator}"><Setter Property="Background" Value="#48566A" /></Style>
</ResourceDictionary>
